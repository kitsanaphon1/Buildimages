pipeline {
    agent any

    environment {
        IMAGE_NAME = "sooyaa02/testbuildimages"
        TRIVY_OUTPUT = "trivy-result.json"
    }

    stages {
        stage('Clone Source') {
            steps {
                git branch: 'deploy', url: 'https://github.com/kitsanaphon1/Buildimages.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    echo "[INFO] Building Docker image..."
                    docker build -t ${IMAGE_NAME}:latest .
                '''
            }
        }

        stage('Ensure jq Installed') {
            steps {
                sh '''
                    echo "[INFO] Ensuring jq is installed..."
                    which jq || (apt-get update && apt-get install -y jq) || (apk add --no-cache jq)
                '''
            }
        }

        stage('Scan Docker Image with Trivy') {
            steps {
                sh '''
                    echo "[INFO] Scanning Docker image using Trivy CLI..."
                    trivy image --format json --timeout 5m ${IMAGE_NAME}:latest > ${TRIVY_OUTPUT}

                    # Extract vulnerability counts per severity using jq
                    CRITICAL=$(jq '[.Results[].Vulnerabilities[]? | select(.Severity=="CRITICAL")] | length' ${TRIVY_OUTPUT})
                    HIGH=$(jq '[.Results[].Vulnerabilities[]? | select(.Severity=="HIGH")] | length' ${TRIVY_OUTPUT})
                    MEDIUM=$(jq '[.Results[].Vulnerabilities[]? | select(.Severity=="MEDIUM")] | length' ${TRIVY_OUTPUT})
                    LOW=$(jq '[.Results[].Vulnerabilities[]? | select(.Severity=="LOW")] | length' ${TRIVY_OUTPUT})
                    UNKNOWN=$(jq '[.Results[].Vulnerabilities[]? | select(.Severity=="UNKNOWN")] | length' ${TRIVY_OUTPUT})

                    echo "CRITICAL=$CRITICAL" > vuln-summary.txt
                    echo "HIGH=$HIGH" >> vuln-summary.txt
                    echo "MEDIUM=$MEDIUM" >> vuln-summary.txt
                    echo "LOW=$LOW" >> vuln-summary.txt
                    echo "UNKNOWN=$UNKNOWN" >> vuln-summary.txt
                '''
            }
        }

        stage('Login to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: '12345',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        echo "[INFO] Logging into Docker Hub..."
                        echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                    '''
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                sh '''
                    echo "[INFO] Pushing Docker image to Docker Hub..."
                    docker push ${IMAGE_NAME}:latest
                '''
            }
        }
    }

    post {
        always {
            script {
                def vulnSummary = fileExists('vuln-summary.txt') ? readFile('vuln-summary.txt') : "No summary available"
                emailext (
                    to: 'cholwww01@gmail.com',
                    subject: "Trivy Scan Report: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                    body: """\
<b>Build Result:</b> ${currentBuild.currentResult}<br>
<b>Project:</b> ${env.JOB_NAME}<br>
<b>Build Number:</b> ${env.BUILD_NUMBER}<br><br>
<b>Trivy Vulnerability Summary:</b><br>
<pre>${vulnSummary}</pre>
""",
                    mimeType: 'text/html',
                    attachLog: true
                )
            }
        }
    }
}
