pipeline {
    agent any

    environment {
        IMAGE_NAME = "sooyaa02/testbuildimages"
        SCAN_JSON = "trivy-result.json"
        EXPORTER_RESULT_PATH = "/opt/trivy/result.json" // ต้องตรงกับ docker-compose mount
    }

    stages {
        stage('Clone Source') {
            steps {
                git branch: 'deploy', url: 'https://github.com/kitsanaphon1/Buildimages.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    echo "[INFO] Building Docker image..."
                    docker build -t ${IMAGE_NAME}:latest .
                '''
            }
        }

        stage('Scan Docker Image with Trivy') {
            steps {
                sh '''
                    echo "[INFO] Scanning Docker image using Trivy CLI..."
                    trivy image --format json --timeout 5m ${IMAGE_NAME}:latest > ${SCAN_JSON}
                '''
            }
        }

        stage('Copy Scan Result to Exporter Volume') {
            steps {
                sh '''
                    echo "[INFO] Copying scan result to Trivy Exporter volume..."
                    mkdir -p $(dirname ${EXPORTER_RESULT_PATH})
                    cp ${SCAN_JSON} ${EXPORTER_RESULT_PATH}
                '''
            }
        }

        stage('Login to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: '12345', // <-- อย่าลืมตั้ง Jenkins Credentials ไว้
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        echo "[INFO] Logging into Docker Hub..."
                        echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                    '''
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                sh '''
                    echo "[INFO] Pushing Docker image to Docker Hub..."
                    docker push ${IMAGE_NAME}:latest
                '''
            }
        }
    }

    post {
        always {
            emailext (
                to: 'cholwww01@gmail.com',
                subject: "Jenkins Build & Trivy Scan Report: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """\
<b>Build Result:</b> ${currentBuild.currentResult}<br>
<b>Project:</b> ${env.JOB_NAME}<br>
<b>Build Number:</b> ${env.BUILD_NUMBER}<br>
<b>Trivy scan result is available and metrics have been exported to Prometheus.</b>
""",
                attachmentsPattern: "${SCAN_JSON}",
                mimeType: 'text/html'
            )
        }
    }
}
