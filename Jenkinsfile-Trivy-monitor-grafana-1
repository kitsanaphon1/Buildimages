pipeline {
    agent any

    environment {
        VERSION = "${BUILD_NUMBER}"
        IMAGE_NAME = "sooyaa02/testbuildimages"
        SCAN_JSON = "trivy-result.json"
        EXPORTER_RESULT_PATH = "/opt/trivy/result.json"  // Path จริงที่ Trivy Exporter รออ่าน
        TRIVY_SERVER_URL = "http://localhost:4954"
    }

    stages {
        stage('Clone Source Code') {
            steps {
                git branch: 'deploy', url: 'https://github.com/kitsanaphon1/Buildimages.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${IMAGE_NAME}:latest ."
            }
        }

        stage('Trivy Scan via Trivy Server') {
            steps {
                sh '''
                    echo "[INFO] Scanning Docker image with Trivy Server..."
                    docker run --rm aquasec/trivy image \
                      --server ${TRIVY_SERVER_URL} \
                      --format json \
                      --timeout 5m \
                      ${IMAGE_NAME}:latest > ${SCAN_JSON}
                '''
            }
        }

        stage('Copy Result to Exporter Volume') {
            steps {
                sh '''
                    echo "[INFO] Copying Trivy scan result to Exporter shared volume..."
                    mkdir -p $(dirname ${EXPORTER_RESULT_PATH})
                    cp ${SCAN_JSON} ${EXPORTER_RESULT_PATH}
                '''
            }
        }

        stage('Login to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: '12345',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                sh "docker push ${IMAGE_NAME}:latest"
            }
        }
    }

    post {
        always {
            emailext (
                to: 'cholwww01@gmail.com',
                subject: "Jenkins Trivy Scan Report: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """\
<b>Build Result:</b> ${currentBuild.currentResult}<br>
<b>Project:</b> ${env.JOB_NAME}<br>
<b>Build Number:</b> ${env.BUILD_NUMBER}<br>
<b>Trivy scan result has been delivered to Prometheus Exporter.</b>
""",
                attachmentsPattern: "${SCAN_JSON}",
                mimeType: 'text/html'
            )
        }
    }
}
