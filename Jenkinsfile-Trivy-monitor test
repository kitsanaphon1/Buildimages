pipeline {
    agent any

    environment {
        VERSION = "${BUILD_NUMBER}"
        IMAGE_NAME = "sooyaa02/testbuildimages"
    }

    stages {
        stage('Clone source code') {
            steps {
                git branch: 'deploy', url: 'https://github.com/kitsanaphon1/Buildimages.git'
            }
        }

        stage('Build Docker image') {
            steps {
                sh "docker build --network=host -t ${IMAGE_NAME}:latest ."
            }
        }

        stage('Trivy Scan') {
            steps {
                sh '''
                    echo "[INFO] Scanning Docker image with Trivy and saving HTML report..."
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      -v $(pwd):/output \
                      aquasec/trivy image \
                      --format table \
                      -o /output/trivy-report.html \
                      ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Login to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: '12345',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                sh "docker push ${IMAGE_NAME}:latest"
            }
        }
    }

    post {
        success {
            emailext(
                subject: "Build Success: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: '<p>Build สำเร็จแล้ว</p>' +
                      '<p><b>Project:</b> ${env.JOB_NAME}<br>' +
                      '<b>Build:</b> #${env.BUILD_NUMBER}</p>' +
                      '<p><a href="${env.BUILD_URL}">ดูรายละเอียด</a></p>',
                mimeType: 'text/html',
                attachmentsPattern: 'trivy-report.html',
                to: 'cholwww01@gmail.com'
            )
        }
        failure {
            emailext(
                subject: "Build Failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: '<p>เกิดข้อผิดพลาดใน Pipeline!</p>' +
                      '<p><b>Project:</b> ${env.JOB_NAME}<br>' +
                      '<b>Build:</b> #${env.BUILD_NUMBER}</p>' +
                      '<p><a href="${env.BUILD_URL}">คลิกดู log</a></p>',
                mimeType: 'text/html',
                attachmentsPattern: 'trivy-report.html',
                to: 'cholwww01@gmail.com'
            )
        }
    }
}
