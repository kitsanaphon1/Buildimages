pipeline {
    agent any

    environment {
        VERSION = "${BUILD_NUMBER}"
        IMAGE_NAME = "sooyaa02/testbuildimages"
        SCAN_RESULT_FILE = "trivy-result.json"
    }

    stages {
        stage('Clone source code') {
            steps {
                git branch: 'deploy', url: 'https://github.com/kitsanaphon1/Buildimages.git'
            }
        }

        stage('Build Docker image') {
            steps {
                sh "docker build --network=host -t ${IMAGE_NAME}:latest ."
            }
        }

        stage('Trivy Scan') {
            steps {
                sh '''
                    echo "[INFO] Scanning Docker image with Trivy..."
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      -v $(pwd):/root/.cache/ \
                      aquasec/trivy image --format json -o trivy-result.json ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Parse Trivy Result') {
            steps {
                script {
                    def scanJson = readJSON file: "${env.SCAN_RESULT_FILE}"
                    def severities = ['LOW': 0, 'MEDIUM': 0, 'HIGH': 0, 'CRITICAL': 0]

                    scanJson.Results.each { result ->
                        result.Vulnerabilities?.each { vuln ->
                            def sev = vuln.Severity.toUpperCase()
                            if (severities.containsKey(sev)) {
                                severities[sev] += 1
                            }
                        }
                    }

                    env.LOW_COUNT = severities.LOW.toString()
                    env.MEDIUM_COUNT = severities.MEDIUM.toString()
                    env.HIGH_COUNT = severities.HIGH.toString()
                    env.CRITICAL_COUNT = severities.CRITICAL.toString()
                }
            }
        }

        stage('Login to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: '12345',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                sh "docker push ${IMAGE_NAME}:latest"
            }
        }
    }

    post {
        always {
            emailext(
                subject: "Trivy Scan Report for ${env.IMAGE_NAME}:${env.VERSION}",
                body: """
                    <h3>Trivy Scan Summary</h3>
                    <p>Docker Image: <b>${env.IMAGE_NAME}:latest</b></p>
                    <ul>
                        <li><b>Low:</b> ${env.LOW_COUNT}</li>
                        <li><b>Medium:</b> ${env.MEDIUM_COUNT}</li>
                        <li><b>High:</b> ${env.HIGH_COUNT}</li>
                        <li><b>Critical:</b> ${env.CRITICAL_COUNT}</li>
                    </ul>
                    <p>See attached Trivy JSON log for details.</p>
                """,
                to: 'cholwww01@gmail.com',
                mimeType: 'text/html',
                attachmentsPattern: 'trivy-result.json'
            )
        }
    }
}
